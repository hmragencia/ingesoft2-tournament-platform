    {
      "id": "gw",
      "name": "Payment gateway: the organization's own ePayco account (PCI DSS)",
      "collapsed": true
    },
    {
      "id": "fan",
      "name": "Fan",
      "lanes": [
        {
          "id": "fanl",
          "name": "Registered fan",
          "height": 130
        }
      ]
    },
    {
      "id": "pm",
      "name": "Public Module (site of the organization)",
