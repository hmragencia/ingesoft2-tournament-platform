      "lane": "pmsys",
      "col": 8,
      "dy": 25
    },
    {
      "id": "cancel",
      "type": "serviceTask",
      "name": "Cancel booking",
      "lane": "pmsys",
      "col": 8,
      "dy": -70
    },
    {
      "id": "cancelled",
      "type": "endEvent",
      "name": "Booking cancelled",
      "lane": "pmsys",
      "col": 9,
      "dy": -70
