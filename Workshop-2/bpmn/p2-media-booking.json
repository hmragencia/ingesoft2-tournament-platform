    {
      "id": "choose",
      "type": "userTask",
      "name": "Choose package and scheduled match",
      "lane": "fanl",
      "col": 1
    },
    {
      "id": "request",
      "type": "userTask",
      "name": "Request booking",
      "lane": "fanl",
      "col": 2
