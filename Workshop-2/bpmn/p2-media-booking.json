        {
          "id": "pmsys",
          "name": "Public site (automatic)",
          "height": 240
        }
      ]
    },
    {
      "id": "org",
      "name": "Organization",
      "lanes": [
        {
          "id": "orgl",
          "name": "Organizer",
          "height": 120
        },
        {
          "id": "photo",
          "name": "Photographer / videographer",
          "height": 120
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "fstart",
      "type": "startEvent",
      "name": "Wants photos or video of a match",
      "lane": "fanl",
      "col": 0
