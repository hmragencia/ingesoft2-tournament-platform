      "name": "Payment webhook received",
      "lane": "pmsys",
      "col": 6,
      "dy": 25
    },
    {
      "id": "paid",
      "type": "gateway",
      "name": "Payment approved?",
      "lane": "pmsys",
      "col": 7,
      "dy": 25
    },
    {
      "id": "confirmb",
      "type": "serviceTask",
