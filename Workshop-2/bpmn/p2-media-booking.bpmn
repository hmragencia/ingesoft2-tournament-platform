      <bpmndi:BPMNShape id="Pool_P2_org_di" bpmnElement="Pool_P2_org" isHorizontal="true"><dc:Bounds x="0" y="550" width="2120" height="240"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P2_orgl_di" bpmnElement="Lane_P2_orgl" isHorizontal="true"><dc:Bounds x="30" y="550" width="2090" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P2_photo_di" bpmnElement="Lane_P2_photo" isHorizontal="true"><dc:Bounds x="30" y="670" width="2090" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_fstart_di" bpmnElement="P2_fstart"><dc:Bounds x="124" y="147" width="36" height="36"/></bpmndi:BPMNShape>
