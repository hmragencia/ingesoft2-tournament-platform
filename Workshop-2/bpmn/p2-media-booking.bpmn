<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P2" targetNamespace="https://github.com/hmragencia/ingesoft2-tournament-platform">
  <bpmn:collaboration id="Collaboration_P2">
    <bpmn:participant id="Pool_P2_gw" name="Payment gateway (ePayco, PCI DSS)"/>
    <bpmn:participant id="Pool_P2_fan" name="Fan" processRef="Process_P2_fan"/>
    <bpmn:participant id="Pool_P2_pm" name="Public Module (this project)" processRef="Process_P2_pm"/>
    <bpmn:participant id="Pool_P2_org" name="Organization" processRef="Process_P2_org"/>
    <bpmn:messageFlow id="Msg_P2_0" name="Booking request" sourceRef="P2_request" targetRef="P2_pstart"/>
    <bpmn:messageFlow id="Msg_P2_1" name="Checkout link" sourceRef="P2_create" targetRef="P2_pay"/>
    <bpmn:messageFlow id="Msg_P2_2" name="Card or PSE payment" sourceRef="P2_pay" targetRef="Pool_P2_gw"/>
    <bpmn:messageFlow id="Msg_P2_3" name="Signed webhook" sourceRef="Pool_P2_gw" targetRef="P2_webhook"/>
    <bpmn:messageFlow id="Msg_P2_4" name="Booking paid" sourceRef="P2_confirmb" targetRef="P2_ostart"/>
    <bpmn:messageFlow id="Msg_P2_5" name="Delivery link" sourceRef="P2_cover" targetRef="P2_linkup"/>
    <bpmn:messageFlow id="Msg_P2_6" name="Delivery link" sourceRef="P2_notifyc" targetRef="P2_linkin"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P2_fan" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2_fan">
      <bpmn:lane id="Lane_P2_fanl" name="Registered fan">
        <bpmn:flowNodeRef>P2_fstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_linkin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_fend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_fstart" name="Wants photos or video of a match"></bpmn:startEvent>
    <bpmn:userTask id="P2_choose" name="Choose package and scheduled match"></bpmn:userTask>
    <bpmn:userTask id="P2_request" name="Request booking"></bpmn:userTask>
    <bpmn:userTask id="P2_pay" name="Pay on the gateway page"></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P2_linkin" name="Delivery link received"><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P2_open" name="Open photos or video"></bpmn:userTask>
    <bpmn:endEvent id="P2_fend" name="Material received"></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P2_0" sourceRef="P2_fstart" targetRef="P2_choose"/>
    <bpmn:sequenceFlow id="Flow_P2_1" sourceRef="P2_choose" targetRef="P2_request"/>
    <bpmn:sequenceFlow id="Flow_P2_2" sourceRef="P2_request" targetRef="P2_pay"/>
    <bpmn:sequenceFlow id="Flow_P2_3" sourceRef="P2_pay" targetRef="P2_linkin"/>
    <bpmn:sequenceFlow id="Flow_P2_4" sourceRef="P2_linkin" targetRef="P2_open"/>
    <bpmn:sequenceFlow id="Flow_P2_5" sourceRef="P2_open" targetRef="P2_fend"/>
  </bpmn:process>
  <bpmn:process id="Process_P2_pm" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2_pm">
      <bpmn:lane id="Lane_P2_pmsys" name="Public site (automatic)">
        <bpmn:flowNodeRef>P2_pstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_webhook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_confirmb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_linkup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_notifyc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_pend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_pstart" name="Booking requested"><bpmn:messageEventDefinition/></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P2_check" name="Scheduled match, before cut-off?"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_create" name="Create pending booking and checkout"></bpmn:serviceTask>
    <bpmn:endEvent id="P2_refused" name="Request refused"></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="P2_webhook" name="Payment webhook received"><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P2_paid" name="Payment approved?"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_confirmb" name="Confirm booking (once per gateway reference)"></bpmn:serviceTask>
    <bpmn:serviceTask id="P2_cancel" name="Cancel booking"></bpmn:serviceTask>
    <bpmn:endEvent id="P2_cancelled" name="Booking cancelled"></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="P2_linkup" name="Delivery link uploaded"><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="P2_notifyc" name="Notify customer (e-mail and push)"></bpmn:sendTask>
    <bpmn:endEvent id="P2_pend" name="Booking delivered"></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P2_6" sourceRef="P2_pstart" targetRef="P2_check"/>
    <bpmn:sequenceFlow id="Flow_P2_7" name="Yes" sourceRef="P2_check" targetRef="P2_create"/>
    <bpmn:sequenceFlow id="Flow_P2_8" name="No" sourceRef="P2_check" targetRef="P2_refused"/>
    <bpmn:sequenceFlow id="Flow_P2_9" sourceRef="P2_create" targetRef="P2_webhook"/>
    <bpmn:sequenceFlow id="Flow_P2_10" sourceRef="P2_webhook" targetRef="P2_paid"/>
    <bpmn:sequenceFlow id="Flow_P2_11" name="Yes" sourceRef="P2_paid" targetRef="P2_confirmb"/>
    <bpmn:sequenceFlow id="Flow_P2_12" name="No" sourceRef="P2_paid" targetRef="P2_cancel"/>
    <bpmn:sequenceFlow id="Flow_P2_13" sourceRef="P2_cancel" targetRef="P2_cancelled"/>
    <bpmn:sequenceFlow id="Flow_P2_14" sourceRef="P2_confirmb" targetRef="P2_linkup"/>
    <bpmn:sequenceFlow id="Flow_P2_15" sourceRef="P2_linkup" targetRef="P2_notifyc"/>
    <bpmn:sequenceFlow id="Flow_P2_16" sourceRef="P2_notifyc" targetRef="P2_pend"/>
  </bpmn:process>
  <bpmn:process id="Process_P2_org" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2_org">
      <bpmn:lane id="Lane_P2_orgl" name="Organizer">
        <bpmn:flowNodeRef>P2_ostart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2_photo" name="Photographer / videographer">
        <bpmn:flowNodeRef>P2_cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_phend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_ostart" name="Paid booking received"><bpmn:messageEventDefinition/></bpmn:startEvent>
    <bpmn:userTask id="P2_assign" name="Assign photographer to the match"></bpmn:userTask>
    <bpmn:userTask id="P2_cover" name="Cover the match and upload delivery link"></bpmn:userTask>
    <bpmn:endEvent id="P2_phend" name="Material delivered"></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P2_17" sourceRef="P2_ostart" targetRef="P2_assign"/>
    <bpmn:sequenceFlow id="Flow_P2_18" sourceRef="P2_assign" targetRef="P2_cover"/>
    <bpmn:sequenceFlow id="Flow_P2_19" sourceRef="P2_cover" targetRef="P2_phend"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P2">
    <bpmndi:BPMNPlane id="Plane_P2" bpmnElement="Collaboration_P2">
      <bpmndi:BPMNShape id="Pool_P2_gw_di" bpmnElement="Pool_P2_gw" isHorizontal="true"><dc:Bounds x="0" y="0" width="2120" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_P2_fan_di" bpmnElement="Pool_P2_fan" isHorizontal="true"><dc:Bounds x="0" y="100" width="2120" height="130"/></bpmndi:BPMNShape>
